{
  "permissions": {
    "allow": [
      "Bash(node --test *)"
    ],
    "ask": [
      "Bash(git push *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Bash(cat .env*)",
      "Bash(design-harness approve *)",
      "Bash(npm run approve *)",
      "Bash(node *scripts/approve.mjs *)",
      "Bash(node *bin/design-harness approve *)",
      "Edit(**/approvals.json)",
      "Write(**/approvals.json)"
    ]
  },
  "enabledPlugins": {
    "design-harness@design-harness": true
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/run-tests.mjs\"",
            "timeout": 90
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/lint-web.mjs\" --hook",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
