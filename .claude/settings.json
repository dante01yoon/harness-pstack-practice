{
  "permissions": {
    "allow": [
      "Bash(node --test *)",
      "Bash(design-harness lint:web *)",
      "Bash(design-harness check *)",
      "Bash(design-harness check)",
      "Bash(python3 -m http.server *)",
      "Bash(git status *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git diff)",
      "Bash(git log *)",
      "Bash(git log)",
      "Edit(/tests/**)"
    ],
    "deny": [
      "Read(/.env)",
      "Read(/.env.*)",
      "Edit(/.env)",
      "Edit(/.env.*)",
      "Bash(cat .env*)",
      "Bash(git add -f *)",
      "Bash(git add --force *)",
      "Edit(/work/seoul-parking/approvals.json)",
      "Edit(/work/seoul-parking/failures.jsonl)",
      "Edit(/work/seoul-parking/DESIGN.md)",
      "Edit(/work/seoul-parking/HANDOFF.md)",
      "Bash(design-harness approve *)"
    ],
    "ask": [
      "Edit(/work/seoul-parking/PRD.md)",
      "Edit(/work/seoul-parking/tokens.json)",
      "Edit(/work/seoul-parking/components.json)",
      "Edit(/work/seoul-parking/copy.json)",
      "Edit(/work/seoul-parking/ia.json)",
      "Edit(/work/seoul-parking/wireframes.json)",
      "Edit(/data/parking.json)",
      "Edit(/.claude/settings.json)",
      "Edit(/.github/workflows/**)",
      "Bash(git push *)",
      "Bash(git commit *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/after-edit.sh",
            "timeout": 90,
            "statusMessage": "고친 파일 검사 중"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/before-stop.sh",
            "timeout": 150,
            "statusMessage": "끝내기 전 앱 검사 중"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "design-harness@design-harness": true,
    "pstack@cursor-plugins": true
  }
}
