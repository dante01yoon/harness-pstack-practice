{
  "$description": "서울 공영주차장 빈자리 확인(휴대폰 웹, 360px부터). 방향: 도로 주차 표지판의 청색 판과 흰 글자를 빌린 '안내판' 언어 — 둥근 카드와 그림자 대신 구분선으로 나눈 단일 열 행, 빈자리 숫자는 크게, 기준 시각은 숫자 바로 옆. 상태는 색 + 글자 + 아이콘을 함께 쓰고 색만으로 구분하지 않는다. primitive(값) -> semantic(의도) 두 층이며 화면·코드는 semantic만 쓴다.",
  "primitive": {
    "color": {
      "$type": "color",
      "sign-blue-800": { "$value": "#0A4A94", "$description": "주차 표지판 청색. 흰 글자 8.68:1" },
      "sign-blue-50": { "$value": "#E6EEF8" },
      "ink-900": { "$value": "#16202A" },
      "ink-600": { "$value": "#475563" },
      "ink-400": { "$value": "#7A8794", "$description": "입력칸·없음 표시 테두리용(비글자 3:1 이상)" },
      "ink-200": { "$value": "#D3DAE1", "$description": "구분선(장식, 대비 요구 없음)" },
      "paper-0": { "$value": "#FFFFFF" },
      "paper-50": { "$value": "#F2F4F6" },
      "amber-800": { "$value": "#6E4300" },
      "amber-50": { "$value": "#FFF1D6" },
      "red-800": { "$value": "#B0261C" },
      "red-50": { "$value": "#FCEBEA" }
    }
  },
  "color": {
    "$type": "color",
    "brand": { "$value": "{primitive.color.sign-blue-800}", "$description": "주 행동(새로고침·다시 시도), 선택된 구 칩, 전화 링크" },
    "brand-soft": { "$value": "{primitive.color.sign-blue-50}", "$description": "선택된 구 칩 바탕, 누름 상태 바탕" },
    "on-brand": { "$value": "{primitive.color.paper-0}" },
    "text": { "$value": "{primitive.color.ink-900}", "$description": "본문·주차장 이름·빈자리 숫자" },
    "text-muted": { "$value": "{primitive.color.ink-600}", "$description": "주소·기준 시각·보조 설명·출처" },
    "surface": { "$value": "{primitive.color.paper-0}", "$description": "기본 바탕(목록 행, 상세 본문)" },
    "surface-sunken": { "$value": "{primitive.color.paper-50}", "$description": "구 묶음 제목 띠, 실시간 정보 없음 칸, 하단 출처, 불러오는 중 자리 표시" },
    "border": { "$value": "{primitive.color.ink-200}", "$description": "행 구분선(장식)" },
    "border-strong": { "$value": "{primitive.color.ink-400}", "$description": "검색 입력칸·칩·버스전용 태그·실시간 정보 없음 점선 테두리. 바탕 대비 3:1 이상" },
    "warning": { "$value": "{primitive.color.amber-800}", "$description": "20분 초과 기준 시각 글자·아이콘·경고 띠 테두리" },
    "warning-soft": { "$value": "{primitive.color.amber-50}", "$description": "오래됨 경고 띠 바탕" },
    "danger": { "$value": "{primitive.color.red-800}", "$description": "불러오기 실패 글자·아이콘" },
    "danger-soft": { "$value": "{primitive.color.red-50}", "$description": "불러오기 실패 상태 바탕" },
    "focus": { "$value": "{primitive.color.sign-blue-800}", "$description": "키보드 포커스 고리 2px" }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "5": { "$value": "20px" },
    "6": { "$value": "24px" },
    "8": { "$value": "32px" }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": "4px", "$description": "칩·태그·버튼. 표지판 판처럼 거의 각진 모서리" },
    "md": { "$value": "8px", "$description": "검색 입력칸·상태 안내 상자" }
  },
  "size": {
    "$type": "dimension",
    "touch": { "$value": "44px" },
    "header": { "$value": "48px" },
    "input": { "$value": "48px" },
    "row": { "$value": "96px", "$description": "목록 행 최소 높이(와이어프레임 96)" },
    "icon": { "$value": "20px" },
    "icon-lg": { "$value": "24px" },
    "focus-ring": { "$value": "2px" }
  },
  "font-size": {
    "$type": "dimension",
    "caption": { "$value": "13px", "$description": "출처·태그·기준 시각 보조. 이보다 작게 쓰지 않는다" },
    "label": { "$value": "15px", "$description": "칩·버튼·주소·기준 시각" },
    "body": { "$value": "16px" },
    "title": { "$value": "18px", "$description": "목록 행의 주차장 이름, 상세 섹션 제목" },
    "heading": { "$value": "22px", "$description": "상세 상단 주차장 이름" },
    "count": { "$value": "32px", "$description": "목록 행 빈자리 숫자" },
    "count-lg": { "$value": "48px", "$description": "상세 빈자리 숫자" }
  },
  "font-weight": {
    "$type": "fontWeight",
    "regular": { "$value": 400 },
    "semibold": { "$value": 600 },
    "bold": { "$value": 700 }
  },
  "line-height": {
    "$type": "number",
    "tight": { "$value": 1.15, "$description": "빈자리 숫자" },
    "snug": { "$value": 1.35, "$description": "이름·제목" },
    "body": { "$value": 1.5 }
  },
  "font-family": {
    "$type": "fontFamily",
    "base": {
      "$value": ["IBM Plex Sans KR", "Noto Sans KR", "Apple SD Gothic Neo", "sans-serif"],
      "$description": "Google Fonts 서체라 Figma에서 기본 제공될 가능성이 높지만 figma.json의 fonts로 아직 확인하지 않았다. 숫자는 tabular-nums로 자리 폭을 맞춘다."
    }
  },
  "$extensions": {
    "harness.contrastPairs": [
      { "fg": "{color.text}", "bg": "{color.surface}", "min": 4.5, "where": "주차장 이름, 빈자리 숫자, 상세 본문" },
      { "fg": "{color.text-muted}", "bg": "{color.surface}", "min": 4.5, "where": "주소, 기준 시각, 결과 건수, 버스전용 '승용차 해당 없음'" },
      { "fg": "{color.text}", "bg": "{color.surface-sunken}", "min": 4.5, "where": "구 묶음 제목, '실시간 정보 없음' 글자, 결과 없음·불러오는 중 안내" },
      { "fg": "{color.text-muted}", "bg": "{color.surface-sunken}", "min": 4.5, "where": "하단 출처, 결과 없음 보조 문구" },
      { "fg": "{color.on-brand}", "bg": "{color.brand}", "min": 4.5, "where": "새로고침·다시 시도 버튼 글자" },
      { "fg": "{color.brand}", "bg": "{color.surface}", "min": 4.5, "where": "전화번호 링크, 보조 버튼 글자, 헤더 새로고침 아이콘" },
      { "fg": "{color.brand}", "bg": "{color.brand-soft}", "min": 4.5, "where": "선택된 구 칩 글자" },
      { "fg": "{color.text}", "bg": "{color.brand-soft}", "min": 4.5, "where": "눌린 행 바탕 위 이름" },
      { "fg": "{color.warning}", "bg": "{color.warning-soft}", "min": 4.5, "where": "오래됨 경고 띠 글자·아이콘" },
      { "fg": "{color.text}", "bg": "{color.warning-soft}", "min": 4.5, "where": "오래됨 경고 띠 본문" },
      { "fg": "{color.warning}", "bg": "{color.surface}", "min": 4.5, "where": "행 안에서 20분 넘은 기준 시각 글자" },
      { "fg": "{color.danger}", "bg": "{color.danger-soft}", "min": 4.5, "where": "불러오기 실패 안내 제목·아이콘" },
      { "fg": "{color.text}", "bg": "{color.danger-soft}", "min": 4.5, "where": "불러오기 실패 안내 본문" },
      { "fg": "{color.danger}", "bg": "{color.surface}", "min": 4.5, "where": "상세 안 부분 실패 문구" },
      { "fg": "{color.border-strong}", "bg": "{color.surface}", "min": 3, "where": "검색 입력칸·칩·태그 테두리(비글자 UI 3:1)" },
      { "fg": "{color.focus}", "bg": "{color.surface}", "min": 3, "where": "포커스 고리" },
      { "fg": "{color.brand}", "bg": "{color.surface-sunken}", "min": 3, "where": "선택된 칩 테두리가 묶음 띠 위에 올 때" }
    ],
    "harness.grid": { "base": 4, "margin": 16, "columns": 4, "gutter": 12 },
    "harness.allowRawRadius": [0]
  }
}
